# ClaudeOS: on the first start, delete the installer's temporary partition (ClaudeOS Setup on Windows put
# it at the end of ClaudeOS's space) and grow ClaudeOS's partition into it; also remove the installer's
# boot loader and power-on entry. The installer's finish.sh installs and enables this; it does nothing
# once done (reclaim-installer.sh).
[Unit]
Description=Give ClaudeOS its installer's space
After=local-fs.target
ConditionPathExists=/etc/claudeos/install-id
ConditionPathExists=!/var/lib/claudeos/installer-reclaimed

[Service]
Type=oneshot
ExecStart=/bin/bash /opt/claudeos/app/linux/firstboot/reclaim-installer.sh
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
