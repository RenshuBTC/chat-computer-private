<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- What the Mac app may do under macOS's hardened runtime, with which it's signed (ad hoc, or with the self-signed
     identity: make-signing-identity.sh): listen through the microphone, when you talk to it (macOS asks you first:
     Info.plist's NSMicrophoneUsageDescription). -->
<plist version="1.0">
<dict>
  <key>com.apple.security.device.audio-input</key>
  <true/>
</dict>
</plist>
