{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-loopback",
  "description": "The same, for the app's own page where it comes from the app's own server on this computer (a Mac: see src/loopback.rs), at one of its three ports.",
  "webviews": [
    "main"
  ],
  "platforms": [
    "macOS",
    "linux"
  ],
  "remote": {
    "urls": [
      "http://127.0.0.1:42851",
      "http://127.0.0.1:42852",
      "http://127.0.0.1:42853"
    ]
  },
  "permissions": [
    "allow-show-site",
    "allow-place-site",
    "allow-hide-site",
    "allow-unhide-site",
    "allow-close-site",
    "allow-site-media",
    "allow-search-files",
    "allow-open-file",
    "allow-about",
    "allow-connect-service",
    "allow-forget-service",
    "allow-open-service-item",
    "allow-model-status",
    "allow-chatgpt-status",
    "allow-chatgpt-sign-in",
    "allow-chatgpt-sign-out",
    "allow-chatgpt-ask",
    "allow-way-status",
    "allow-choose-way",
    "allow-show-folder"
  ]
}
