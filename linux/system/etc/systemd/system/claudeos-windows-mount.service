# ClaudeOS: mount the Windows partition at boot (best-effort).
#
# Delegates all the logic to the root helper's `mount-windows` verb so there is
# exactly one implementation of "find Windows, unlock BitLocker if a key file
# exists, mount rw-if-clean-else-ro, never remove the hiberfile". The service
# is best-effort: a missing/locked/absent Windows partition must not block boot,
# so the unit always "succeeds".
[Unit]
Description=ClaudeOS: mount Windows partition at /mnt/windows
# Needs udev-settled block devices; dislocker/ntfs-3g use FUSE. We keep the
# default dependencies (clean ordering vs basic.target/shutdown); "best effort"
# is guaranteed by the '|| true' in ExecStart, not by dropping dependencies.
After=local-fs.target systemd-udev-settle.service
Wants=systemd-udev-settle.service

[Service]
Type=oneshot
RemainAfterExit=yes
# The helper prints JSON to stdout; '|| true' makes a locked/absent Windows a
# non-fatal condition so the AI session always comes up.
ExecStart=/bin/sh -c '/usr/local/libexec/claudeos/claudeos-root mount-windows || true'
# Nothing to unmount on shutdown that systemd will not handle via the mount.

[Install]
WantedBy=multi-user.target
