# Chat Computer: allow the autologin console user to start rootless Xorg.
#
# Chat Computer runs X from the tty1 autologin session via startx, with no display
# manager. xserver-xorg-legacy's Xorg.wrap enforces who may start the server;
# "console" lets any user logged in on a physical VT start it (which is exactly
# our autologin user) without granting "anybody". needs_root_rights=auto lets
# the kernel/DRM + logind give the server the rights it needs rootlessly on
# modern GPUs; Xorg drops to the invoking user (modern "rootless X").
allowed_users=console
needs_root_rights=auto
